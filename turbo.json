{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "apps/**/*.env*",
        "packages/**/*.env*"
      ],
      "outputs": ["dist/**", ".svelte-kit/**", "!.svelte-kit/cache/**"],
      "env": [
        "SANITY_VIEWER_TOKEN",
        "PUBLIC_SANITY_PROJECT_ID",
        "PUBLIC_SANITY_DATASET",
        "PUBLIC_SANITY_API_VERSION",
        "PUBLIC_SANITY_STUDIO_URL",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_TITLE",
        "SANITY_STUDIO_PRESENTATION_URL",
        "REVALIDATION_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "PUBLIC_SANITY_PROJECT_ID",
        "PUBLIC_SANITY_DATASET",
        "PUBLIC_SANITY_API_VERSION",
        "PUBLIC_SANITY_STUDIO_URL",
        "PUBLIC_ANALYTICS"
      ]
    }
  }
}
